# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only. NEVER expose this key in browser code.
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# First administrator bootstrap account
ATIS_ADMIN_EMAIL=admin@example.com
ATIS_ADMIN_USERNAME=admin
ATIS_ADMIN_PASSWORD=ChangeMe123!
ATIS_ADMIN_FULL_NAME=ATIS Administrator
